  "textRules": [
    {
      "id": "private-key",
      "pattern": "-----BEGIN (?:[A-Z ]*PRIVATE KEY)-----"
    },
    {
      "id": "openai-key",
      "pattern": "\\b(?:sk-(?:proj-|svcacct-)[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,})\\b"
    },
    {
      "id": "github-or-aws-key",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16})\\b"
    },
    {
      "id": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b"
    },
    {
      "id": "bearer",
      "pattern": "(?i)\\bBearer[ \\t]+[A-Za-z0-9_.~+/-]{12,}=*"
    },
    {
      "id": "credential-assignment",
      "pattern": "(?ix)(?:^|[?&]|[\"'\\s])(?:crtfc_key|api[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token|password|passwd|authorization|csrf[_-]?keys?)[\"']?\\s*[:=]\\s*[\"']?(?P<value>[^\\s\"'&<>;,}]{8,})"
    }
  ],
  "credentialFieldPattern": "^(?:.*[_-])?(?:api[_-]?key|password|passwd|client[_-]?secret|access[_-]?token|refresh[_-]?token|id[_-]?token|authorization|proxy[_-]?authorization|cookie|set[_-]?cookie|csrf[_-]?(?:key|keys|secret)|private[_-]?key|secret[_-]?key|client[_-]?key|bearer|token)$",
