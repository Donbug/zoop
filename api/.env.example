# Local development only. Spring Boot does not load this file automatically.
DB_PORT=5432
DB_NAME=zoop
DB_URL=jdbc:postgresql://localhost:5432/zoop
DB_USERNAME=zoop
DB_PASSWORD=zoop_local_only
SERVER_PORT=8080

# Required for member sessions. Put a random 32-byte base64url key in the untracked .env.
# Example: ZOOP_AUTH_CSRF_KEYS=local-v1=<key> (see api/README.md).
ZOOP_AUTH_CSRF_ACTIVE_KEY_ID=local-v1
ZOOP_AUTH_CSRF_KEYS=

# Exact HTTPS origins allowed to submit signup/login. Empty denies those writes.
ZOOP_AUTH_ALLOWED_ORIGINS=
# Numeric IP addresses of reverse proxies allowed to supply X-Forwarded-For.
ZOOP_AUTH_TRUSTED_PROXIES=

# Optional internal AI transport client (S1). Disabled by default; the app starts without any of these.
# Public names only. Put the real operator-issued token in your own untracked .env or secret store, never here.
# Details: api/docs/AI_INTEGRATION.md
ZOOP_AI_CLIENT_ENABLED=false
ZOOP_AI_CLIENT_BASE_URL=
ZOOP_AI_CLIENT_TOKEN=
ZOOP_AI_CLIENT_CONNECT_TIMEOUT=3s
ZOOP_AI_CLIENT_REQUEST_TIMEOUT=30s
ZOOP_AI_CLIENT_MAX_RESPONSE_BYTES=8388608
