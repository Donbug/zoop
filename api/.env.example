# Local development only. Spring Boot does not load this file automatically.
DB_PORT=5432
DB_NAME=zoop
DB_URL=jdbc:postgresql://localhost:5432/zoop
DB_USERNAME=zoop
DB_PASSWORD=zoop_local_only
SERVER_PORT=8080

# Local OAuth testing only. The insecure redirect allowlist is limited to localhost/loopback hosts.
ZOOP_AUTH_SOCIAL_ALLOW_INSECURE_LOCALHOST=true
ZOOP_AUTH_SOCIAL_GOOGLE_CLIENT_ID=
ZOOP_AUTH_SOCIAL_GOOGLE_CLIENT_SECRET=
ZOOP_AUTH_SOCIAL_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/social/google/callback
ZOOP_AUTH_SOCIAL_KAKAO_CLIENT_ID=
ZOOP_AUTH_SOCIAL_KAKAO_CLIENT_SECRET=
ZOOP_AUTH_SOCIAL_KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/social/kakao/callback

# Required for member sessions. Put a random 32-byte base64url key in the untracked .env.
# Example: ZOOP_AUTH_CSRF_KEYS=local-v1=<key> (see api/README.md).
ZOOP_AUTH_CSRF_ACTIVE_KEY_ID=local-v1
ZOOP_AUTH_CSRF_KEYS=

# Exact HTTPS origins allowed to submit signup/login. Empty denies those writes.
ZOOP_AUTH_ALLOWED_ORIGINS=
# Numeric IP addresses of reverse proxies allowed to supply X-Forwarded-For.
ZOOP_AUTH_TRUSTED_PROXIES=

# Optional internal AI transport client (S1). Disabled by default; the app starts without any of these.
# Public names only. Put the real operator-issued token in your own untracked .env or secret store, never here.
# Details: api/docs/AI_INTEGRATION.md
ZOOP_AI_CLIENT_ENABLED=false
ZOOP_AI_CLIENT_BASE_URL=
ZOOP_AI_CLIENT_TOKEN=
ZOOP_AI_CLIENT_CONNECT_TIMEOUT=3s
ZOOP_AI_CLIENT_REQUEST_TIMEOUT=30s
ZOOP_AI_CLIENT_MAX_RESPONSE_BYTES=8388608

# Optional internal AI transport clients for S2 extraction jobs and S3 relation jobs. Each is disabled by default and
# independent of the S1 client above (separate principal and token). Public names only; never put a token here.
ZOOP_AI_EXTRACTION_CLIENT_ENABLED=false
ZOOP_AI_EXTRACTION_CLIENT_BASE_URL=
ZOOP_AI_EXTRACTION_CLIENT_TOKEN=
ZOOP_AI_EXTRACTION_CLIENT_CONNECT_TIMEOUT=3s
ZOOP_AI_EXTRACTION_CLIENT_REQUEST_TIMEOUT=30s
ZOOP_AI_EXTRACTION_CLIENT_MAX_RESPONSE_BYTES=8388608
ZOOP_AI_RELATION_CLIENT_ENABLED=false
ZOOP_AI_RELATION_CLIENT_BASE_URL=
ZOOP_AI_RELATION_CLIENT_TOKEN=
ZOOP_AI_RELATION_CLIENT_CONNECT_TIMEOUT=3s
ZOOP_AI_RELATION_CLIENT_REQUEST_TIMEOUT=30s
ZOOP_AI_RELATION_CLIENT_MAX_RESPONSE_BYTES=8388608

# Optional operator-only, non-web document analysis (api/docs/DOCUMENT_ANALYSIS.md). Disabled by default; the app starts without
# any of these. It also needs the S1 client above (ZOOP_AI_CLIENT_*) and the ingestion paths of the document import; it cannot run
# in the same process as the document import or next to a web server. ZOOP_DOCUMENT_ANALYSIS_GRANTS is the operator's flat S1
# grant registry, the same file the AI service reads. Paths only.
ZOOP_DOCUMENT_ANALYSIS_ENABLED=false
ZOOP_DOCUMENT_ANALYSIS_REQUEST=
ZOOP_DOCUMENT_ANALYSIS_RESULT=
ZOOP_DOCUMENT_ANALYSIS_GRANTS=
