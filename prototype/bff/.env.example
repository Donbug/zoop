# S1 AI worker only. HTTP BFF readers never construct a model provider.
# No .env is loaded implicitly. Supply an approved operator env explicitly to the worker process.
# Explicitly migrate old SENTIMENT model/effort to DOCUMENT_SENTIMENT and BRIEFING_OUTLOOK.
# Existing outlook producer is preserved with its exact policy; new company/market summaries remain future scope.
ZOOP_AI_DOCUMENT_SUMMARY_MODEL=
ZOOP_AI_DOCUMENT_SUMMARY_REASONING_EFFORT=
ZOOP_AI_DOCUMENT_SENTIMENT_MODEL=
ZOOP_AI_DOCUMENT_SENTIMENT_REASONING_EFFORT=
ZOOP_AI_VERIFY_MODEL=
ZOOP_AI_VERIFY_REASONING_EFFORT=
ZOOP_AI_BRIEFING_OUTLOOK_MODEL=
ZOOP_AI_BRIEFING_OUTLOOK_REASONING_EFFORT=
# Empty effort omits the request field. Unsupported provider/model options fail unchanged.
# Accepted effort values: none,minimal,low,medium,high,xhigh,max (support remains provider-specific).
ZOOP_AI_PROVIDER=openai-compatible
ZOOP_AI_BASE_URL=https://api.openai.com/v1
ZOOP_AI_API_KEY=
# Live requires explicit 1, positive durable global call ceiling, stage models and current source grants.
# This example does NOT approve a model, numerical budget, external transmission or source licence.
ZOOP_AI_LIVE_ENABLED=0
ZOOP_AI_GLOBAL_MAX_CALLS=0
