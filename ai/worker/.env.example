# S1 AI worker (zoop-ai) environment template. Names only; NEVER put a real key in this file.
# No .env is loaded implicitly: the operator exports an approved env into the worker process explicitly.
# Check any env offline before use (no request, no state, no grant read, keys shown only as present/absent):
#   zoop-ai config-check --format text [--require-live-prerequisites] --profile native-jev
# Full guide: docs/development/ai-runtime-setup.md
#
# Fail-closed defaults: live off, call ceiling 0. These two lines are the only switches that allow a paid call.
# Filling them in is a separate, explicit approval (budget in CALLS, endpoints, data scope); this file approves nothing.
ZOOP_AI_LIVE_ENABLED=0
ZOOP_AI_GLOBAL_MAX_CALLS=0

# Generation and briefing-outlook transport: OpenAI-compatible chat/completions over https (http only to loopback).
# Native TypeSafe Jev (POST /v1/systemone) must never be placed at this base URL.
ZOOP_AI_PROVIDER=openai-compatible
ZOOP_AI_BASE_URL=https://api.openai.com/v1
# Destination of the OpenAI API key for the worker process (set in the shell/secret store, not here).
# OPENAI_API_KEY is NOT read by the worker.
ZOOP_AI_API_KEY=

# Selected profile: gpt-6-luna with reasoning effort `high` for document summary, document sentiment and briefing-outlook
# (user decision 2026-10-15). gpt-6-luna efforts: none, low, medium, high, xhigh, max (no minimal). Chat Completions + reasoning
# + tools needs the Responses API; S1 sends no tools, so chat is valid. The benchmark pins the model and records the actual
# response model; account access to this model is unverified until the first approved call.
# `python3 ai/worker/scripts/setup_ai_env.py` writes exactly these values into ai/worker/.env (human-run, hidden key prompts).
ZOOP_AI_DOCUMENT_SUMMARY_MODEL=gpt-6-luna
ZOOP_AI_DOCUMENT_SUMMARY_REASONING_EFFORT=high
ZOOP_AI_DOCUMENT_SENTIMENT_MODEL=gpt-6-luna
ZOOP_AI_DOCUMENT_SENTIMENT_REASONING_EFFORT=high
ZOOP_AI_BRIEFING_OUTLOOK_MODEL=gpt-6-luna
ZOOP_AI_BRIEFING_OUTLOOK_REASONING_EFFORT=high

# Semantic verification on native TypeSafe Jev (opt-in; the default, when ZOOP_AI_VERIFY_PROVIDER is unset, stays the
# OpenAI-compatible chat verifier). First-party docs: https://docs.typesafe.ai/api.md. One POST {TYPESAFE_BASE_URL}/systemone per
# verification stage, pinned versioned model (never the moving aliases jev-latest/jev-preview), no retry, no redirect, no
# danger-zone headers. Its Choice/Noul thresholds are PROVISIONAL engineering values (see docs/development/ai-runtime-setup.md).
# The Jev model comes from TYPESAFE_VALIDATION_MODEL and must be exactly jev-1.14.0; reasoning effort does not apply.
# While this is selected, ZOOP_AI_VERIFY_MODEL and ZOOP_AI_VERIFY_REASONING_EFFORT must stay unset: stale values are rejected.
# Personal Jev account/cost is separate from OpenAI. Grant recipients: `openai-compatible:<rev>` for the generation endpoint and
# `typesafe-native:<rev>` for this one (config-check prints both revisions); a generation recipient never authorizes Jev.
# To keep the chat verifier instead: delete ZOOP_AI_VERIFY_PROVIDER and set ZOOP_AI_VERIFY_MODEL / ZOOP_AI_VERIFY_REASONING_EFFORT.
ZOOP_AI_VERIFY_PROVIDER=typesafe-native
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_VALIDATION_MODEL=jev-1.14.0

# Chatbot model stages (`zoop-ai-chat`): a gate, ceiling and receipts separate from S1 and the pipeline. Nothing is sent unless
# ZOOP_AI_CHAT_LIVE_ENABLED=1 and ZOOP_AI_CHAT_MAX_CALLS > 0 (shared by router, answer and verification). The answer stage uses
# the OpenAI-compatible endpoint and key above (ZOOP_AI_BASE_URL / ZOOP_AI_API_KEY); router and verification use native Jev
# (TYPESAFE_BASE_URL / TYPESAFE_API_KEY) with the pinned model below. Quotes are sent only under the operator chat grant
# registry (zoop-ai-chat-1), separate from the S1 registry.
ZOOP_AI_CHAT_LIVE_ENABLED=0
ZOOP_AI_CHAT_MAX_CALLS=0
ZOOP_AI_CHAT_ANSWER_MODEL=gpt-6-luna
ZOOP_AI_CHAT_ANSWER_REASONING_EFFORT=high
# chat-agent: Luna Responses with the ZOOP MCP tools, pinned like chat-answer but at medium effort.
ZOOP_AI_CHAT_AGENT_MODEL=gpt-6-luna
ZOOP_AI_CHAT_AGENT_REASONING_EFFORT=medium
# The ONLY ZOOP MCP server a chat-agent run's grant is sent to (the application's public HTTPS /mcp; default port, no user info,
# query or fragment). Requests never name it. Live chat-agent steps send nothing without it.
ZOOP_AI_CHAT_MCP_SERVER_URL=
ZOOP_AI_CHAT_JEV_MODEL=jev-1.14.0
