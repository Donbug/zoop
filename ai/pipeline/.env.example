# Live (paid) S2/S3 pipeline runtime (`zoop_ai_pipeline.live_runtime`). Names only; NEVER put a real key in this file.
# No .env is ever loaded implicitly: an operator exports an approved environment into ONE pipeline process, and the service passes
# these names only to an explicitly live-enabled S2/S3 child. Replay, graph, handoff, dependency and ingestion commands get none.
# Offline check (no network, no file, keys shown only as present/absent):
#   python -m zoop_ai_pipeline.live_runtime binding     # non-secret configuration + frozen identity + per-stage recipients
#   python -m zoop_ai_pipeline.live_runtime check       # additionally requires the budget variables and both keys
# Full guide: docs/development/ai-runtime-setup.md section 10.
#
# Fail-closed: live is off unless this is exactly 1 (it is NOT the S1 flag ZOOP_AI_LIVE_ENABLED). Filling the rest in is a separate,
# explicit approval; this file approves nothing.
ZOOP_AI_PIPELINE_LIVE_ENABLED=0

# --- non-secret configuration: needed to submit/freeze/inspect/decode (no keys, no budget) ---------------------------------
# Generation stages (extract, compare, topic, relation, impact): OpenAI-compatible chat/completions, strict json_schema.
# The model is pinned to gpt-6-luna (the cost rates are only known for it); effort has no default and must be explicit.
ZOOP_AI_PIPELINE_LIVE_MODEL=gpt-6-luna
ZOOP_AI_PIPELINE_LIVE_REASONING_EFFORT=high
# Optional. https only (plain http only to loopback), no userinfo/query. Default https://api.openai.com/v1
ZOOP_AI_BASE_URL=
# Verifier stages (verify-relation, verify-impact): native TypeSafe Jev POST {TYPESAFE_BASE_URL}/systemone, model exactly jev-1.14.0.
# Do not append /systemone. Optional URL, default https://api.typesafe.ai/v1
TYPESAFE_BASE_URL=
TYPESAFE_VALIDATION_MODEL=jev-1.14.0
# Optional per-call limits (defaults 24000 output tokens including reasoning, 300 seconds). They are frozen in the binding
# (output tokens) or per process (timeout).
ZOOP_AI_PIPELINE_LIVE_MAX_OUTPUT_TOKENS=
ZOOP_AI_PIPELINE_LIVE_TIMEOUT_SECONDS=

# --- pinned at freeze time (it is part of the runtime binding), so submit/freeze needs it too; nothing is created by freezing -------
# One budget directory shared by every S2 and S3 process of the approval (absolute path). Its validated realpath hash is frozen into
# the binding: changing it makes a frozen job refuse to run. The directory (0700) and database are created by the first send.
ZOOP_AI_PIPELINE_LIVE_BUDGET_DIR=
# --- send-time only: required by the first real send, never by freeze/accepts/prepare/answer -----------------------------
# The ceilings bind to the budget directory on first use and may only be lowered (a denied reserve still keeps a lowered ceiling).
# USD is a conservative upper estimate (long-context luna rates, worst-case output, Jev input counted per question), not the provider
# bill; calls count every attempt that may have reached the provider. Deleting the database file by a privileged owner is outside
# this runtime's protection (operational trust boundary).
ZOOP_AI_PIPELINE_LIVE_MAX_USD=
ZOOP_AI_PIPELINE_LIVE_MAX_CALLS=
# Secrets: set in the process environment / secret store, not here. OPENAI_API_KEY is NOT read.
ZOOP_AI_API_KEY=
TYPESAFE_API_KEY=
