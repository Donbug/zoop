# Static container configuration
ZOOP_AI_SERVICE_PORT=8000
ZOOP_AI_SERVICE_HOST=127.0.0.1
ZOOP_AI_SERVICE_STATE_DIR=/var/lib/zoop-ai/service
ZOOP_AI_WORKER_STATE_DIR=/var/lib/zoop-ai/worker
ZOOP_AI_SERVICE_WORKER_COMMAND=/opt/zoop/worker/.venv/bin/zoop-ai
ZOOP_AI_SERVICE_GRANTS=/opt/zoop/fixtures/synthetic-document/grants.json
ZOOP_AI_SERVICE_REPLAY=/opt/zoop/fixtures/synthetic-document/replay.json

# Required authentication configuration.
# Replace the placeholder with the lowercase SHA-256 digest of the
# plaintext token supplied to the Spring API as ZOOP_AI_CLIENT_TOKEN.
ZOOP_AI_SERVICE_PRINCIPALS=[{"principal":"zoop-api","tokenSha256":["<64-lowercase-hex-sha256>"],"scopes":["analysis.submit","analysis.read","analysis.cancel","analysis.recover"]}]

# Replay-only Dev intentionally omits:
# ZOOP_AI_LIVE_ENABLED
# ZOOP_AI_GLOBAL_MAX_CALLS
# ZOOP_AI_PROVIDER
# ZOOP_AI_BASE_URL
# ZOOP_AI_API_KEY

# Read-only delivery profile (separate service state and principal from online admission).
# Behind approved TLS ingress, TaskDefinition sets ZOOP_AI_SERVICE_HOST=0.0.0.0
# and ZOOP_AI_SERVICE_PORT=8000; the image default remains loopback.
# Grant the importer principal handoff.read and observation.read using token digests.
# Supply operator-owned absolute paths; all native source mounts belong to this AI task:
# ZOOP_AI_SERVICE_INGESTION_COMMAND (/opt/zoop/pipeline/.venv/bin/zoop-ai-ingest)
# ZOOP_AI_SERVICE_OBSERVATION_SOURCE_CONTEXTS
# ZOOP_AI_SERVICE_OBSERVATION_SOURCE_CONTEXTS_SHA256
# ZOOP_AI_SERVICE_HANDOFF_COMMAND (/opt/zoop/pipeline/.venv/bin/zoop-ai-handoff)
# ZOOP_AI_HANDOFF_STATE_DIR
# ZOOP_AI_SERVICE_HANDOFF_CANONICAL
# ZOOP_AI_SERVICE_HANDOFF_DECISIONS
# ZOOP_AI_SERVICE_HANDOFF_BINDINGS
# ZOOP_AI_SERVICE_HANDOFF_EXPORTS
# ZOOP_AI_SERVICE_HANDOFF_SOURCE_CONTEXTS
# ZOOP_AI_SERVICE_HANDOFF_SOURCE_CONTEXTS_SHA256
# Both context pairs must name the same file and SHA-256. For a single context,
# replace observation context settings with ZOOP_AI_INGESTION_STATE_DIR and
# ZOOP_AI_SERVICE_SOURCES, and use the handoff singular source settings.

# Optional chat group: separate private state, operator chat grants and chat.invoke principal scope.
# ZOOP_AI_SERVICE_CHAT_COMMAND=/opt/zoop/worker/.venv/bin/zoop-ai-chat
# ZOOP_AI_CHAT_STATE_DIR=/var/lib/zoop-ai/chat
# ZOOP_AI_SERVICE_CHAT_GRANTS=/var/lib/zoop-ai/chat-grants.json
# ZOOP_AI_SERVICE_CHAT_REPLAY=/var/lib/zoop-ai/chat-replay.json
# ZOOP_AI_CHAT_ANSWER_MODEL=gpt-6-luna
# ZOOP_AI_CHAT_AGENT_MODEL=gpt-6-luna
# ZOOP_AI_CHAT_JEV_MODEL=jev-1.14.0
# ZOOP_AI_CHAT_MCP_SERVER_URL=https://api.example.invalid/mcp
# Java owns ZOOP_CHAT_RESOURCE_* policy settings and sends one frozen schema6 resource allocation per invocation.
# The worker's content-free capabilities command works with the chat live gate closed.
# Provider timeout T derives child T+5s, termination grace5s and application HTTP T+13s.
# The local64k output/high effort/600s provider profile is an offline upper bound; live activation needs separate approval.
