      },
      "required": [
        "grantId",
        "revision",
        "sourceId",
        "enabled",
        "rights",
        "allowedOperations",
        "recipients",
        "purposes",
        "evidence",
        "expiresAt"
      ],
      "title": "SourceGrant",
      "type": "object"
    },
    "Submit": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "zoop-ai-s1-1",
          "title": "Schemaversion",
          "type": "string"
        },
        "jobId": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Jobid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "document-summary",
            "document-sentiment",
            "semantic-verification",
            "briefing-outlook"
          ],
          "title": "Kind",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobInput"
            },
            {
              "$ref": "#/$defs/OutlookInput"
            }
          ],
          "title": "Input"
        },
        "mode": {
          "enum": [
            "replay",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "kind",
        "input",
        "mode",
        "provenance"
      ],
      "title": "Submit",
      "type": "object"
    },
