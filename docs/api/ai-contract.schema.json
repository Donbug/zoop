          "type": "string"
        },
        "scheduledAt": {
          "title": "Scheduledat",
          "type": "string"
        },
        "graphVersion": {
          "title": "Graphversion",
          "type": "string"
        },
        "reviewRevision": {
          "title": "Reviewrevision",
          "type": "integer"
        },
        "ruleRevision": {
          "title": "Rulerevision",
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/OutlookIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "documentSentiments": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Documentsentiments",
          "type": "array"
        },
        "marketVariables": {
          "additionalProperties": true,
          "title": "Marketvariables",
          "type": "object"
        },
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "grantId": {
          "title": "Grantid",
          "type": "string"
        },
        "grantRevision": {
          "title": "Grantrevision",
          "type": "string"
        }
      },
      "required": [
        "roundId",
        "scheduledAt",
        "graphVersion",
        "reviewRevision",
        "ruleRevision",
        "issues",
        "documentSentiments",
        "marketVariables",
        "sourceId",
        "grantId",
        "grantRevision"
      ],
      "title": "OutlookInput",
      "type": "object"
    },
    "OutlookIssue": {
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "minLength": 1,
          "title": "Eventid",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "eventTime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Eventtime"
        },
        "companies": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Companies",
          "type": "array"
        }
      },
      "required": [
        "eventId",
        "title",
        "eventTime",
        "companies"
      ],
      "title": "OutlookIssue",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "sourceKind": {
          "enum": [
            "synthetic",
            "actual"
          ],
          "title": "Sourcekind",
          "type": "string"
        },
        "executionMode": {
          "enum": [
            "replay",
            "live"
          ],
          "title": "Executionmode",
          "type": "string"
        },
        "recordingKind": {
          "enum": [
            "authored-test",
            "provider"
          ],
          "title": "Recordingkind",
          "type": "string"
        }
      },
      "required": [
        "sourceKind",
        "executionMode",
        "recordingKind"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RawLocator": {
      "additionalProperties": false,
      "properties": {
        "locatorId": {
          "minLength": 1,
          "title": "Locatorid",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "locatorId",
        "start",
        "end"
      ],
      "title": "RawLocator",
      "type": "object"
    },
    "SentimentAnswer": {
      "additionalProperties": false,
