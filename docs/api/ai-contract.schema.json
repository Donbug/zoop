              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoningtokens"
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost"
        }
      },
      "required": [
        "providerAttempts",
        "replayCalls",
        "inputTokens",
        "outputTokens",
        "cachedTokens",
