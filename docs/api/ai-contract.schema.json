            "mixed",
            "undetermined"
          ],
          "title": "Label",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "label",
        "rationale",
        "claims",
        "citations",
        "limitations"
      ],
      "title": "SentimentAnswer",
      "type": "object"
    },
    "SourceGrant": {
      "additionalProperties": false,
      "properties": {
        "grantId": {
          "minLength": 1,
          "title": "Grantid",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "rights": {
          "enum": [
            "known",
            "unknown",
            "denied"
          ],
          "title": "Rights",
          "type": "string"
        },
        "allowedOperations": {
          "items": {
            "enum": [
              "read",
              "store",
              "model-send",
              "quote-display"
            ],
            "type": "string"
          },
          "title": "Allowedoperations",
          "type": "array"
        },
        "recipients": {
          "items": {
            "type": "string"
          },
          "title": "Recipients",
          "type": "array"
        },
        "purposes": {
          "items": {
            "enum": [
              "document-summary",
              "document-sentiment",
              "semantic-verification",
              "briefing-outlook"
            ],
            "type": "string"
          },
          "title": "Purposes",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
