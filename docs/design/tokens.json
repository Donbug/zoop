{
  "$schema": "https://design-tokens.github.io/community-group/format/2025.10/schema.json",
  "name": "Zoop Design Tokens",
  "version": "3.0.0",
  "description": "줍(Zoop) 디자인 토큰 단일 원천(W3C DTCG 2025.10). 색은 OKLCH에서 계산해 WCAG AA 대비를 검증한 Main 확정 팔레트. 모션은 당근 SEED(seed-design.io/foundations/motion)의 duration·timing-function 값을 옮겼다. 수정 후 prototype/web에서 `pnpm tokens`.",
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": "#0A5C48",
        "$description": "브랜드 딥 스프루스 틸. 화면당 주 행동 1개, 현재 탭·선택 표시에만 쓴다."
      },
      "primary-hover": {
        "$value": "#0E7059",
        "$description": "주 행동 버튼 호버"
      },
      "primary-active": {
        "$value": "#074838",
        "$description": "주 행동 버튼 눌림"
      },
      "primary-foreground": {
        "$value": "#FFFFFF",
        "$description": "브랜드 배경 위 글자·아이콘"
      }
    },
    "neutral": {
      "surface-base": {
        "$value": "#F8FAF9",
        "$description": "앱 배경·그래프 캔버스. 중성은 브랜드 hue(170)로 아주 약하게 기운 회색."
      },
      "surface-raised": {
        "$value": "#FFFFFF",
        "$description": "헤더·패널·사이드바 표면"
      },
      "surface-overlay": {
        "$value": "#FFFFFF",
        "$description": "다이얼로그·시트·팝오버·토스트 표면"
      },
      "surface-sunken": {
        "$value": "#F0F3F2",
        "$description": "세그먼트 배경, 인용문 배경, 중립 배지 배경, 행 호버"
      },
      "surface-selected": {
        "$value": "#E4F5EE",
        "$description": "선택된 행·탭 배경(selected-bg). 텍스트 굵기와 함께 쓴다."
      },
      "border-subtle": {
        "$value": "#DFE4E2",
        "$description": "행 구분선, 섹션 경계"
      },
      "border-strong": {
        "$value": "#C2C9C6",
        "$description": "보조 버튼 테두리 등 장식 아닌 경계"
      },
      "border-control": {
        "$value": "#818885",
        "$description": "입력창·체크박스 테두리(비텍스트 대비 3:1 이상)"
      },
      "border-focus": {
        "$value": "#0A5C48",
        "$description": "키보드 포커스 링(2px)"
      },
      "text-primary": {
        "$value": "#19201D",
        "$description": "본문·제목"
      },
      "text-secondary": {
        "$value": "#474F4C",
        "$description": "보조 설명, 발행 시각, 출처"
      },
      "text-tertiary": {
        "$value": "#636B68",
        "$description": "각주, 플레이스홀더, 비활성 글자. 13px 이상에서만."
      },
      "text-inverse": {
        "$value": "#FFFFFF",
        "$description": "어두운 배경(툴팁) 위 글자"
      }
    },
    "semantic": {
      "up": {
        "$value": "#BE222A",
        "$description": "상승(빨강). 부호 +와 ▲를 함께 쓴다."
      },
      "down": {
        "$value": "#145EC1",
        "$description": "하락(파랑). 부호 -와 ▼를 함께 쓴다."
      },
      "warning": {
        "$value": "#915C08",
        "$description": "보류·확인 필요 글자와 아이콘"
      },
      "error": {
        "$value": "#B21F41",
        "$description": "오류 글자, 오류 입력 테두리"
      }
    },
    "graph": {
      "node-issue": {
        "$value": "#4B5652",
        "$description": "사건 노드 범주색(원 하나 + 번개 아이콘). 기업은 상징색을 쓰므로 사건은 채도 없는 한 가지 색으로만 구분한다. 배경 대비 7.3:1, 흰 아이콘 7.6:1."
      },
      "node-glyph": {
        "$value": "#FFFFFF",
        "$description": "사건 노드 안 아이콘 색"
      },
      "node-mark": {
        "$value": "#19201D",
        "$description": "보유·관심 기업 노드의 3px 바깥 테두리(모양 신호)"
      },
      "company-fallback": {
        "1": { "$value": "#2F6F9F", "$description": "상징색이 없는 기업의 고정 폴백 팔레트. company_id 해시로 고른다(항상 같은 색). 흰 이니셜 대비 4.5:1 이상." },
        "2": { "$value": "#8A5A2B" },
        "3": { "$value": "#6B4FA0" },
        "4": { "$value": "#2E7D5B" },
        "5": { "$value": "#A2463F" },
        "6": { "$value": "#5B6B2A" },
        "7": { "$value": "#2B7A85" },
        "8": { "$value": "#8E4A78" }
      },
      "focus-ring": {
        "$value": "#0A5C48",
        "$description": "선택 노드·간선의 2px 실선 링. 글로우 없음."
      },
      "dimmed-opacity": {
        "$type": "number",
        "$value": 0.22,
        "$description": "선택과 무관한 요소의 불투명도. 흐려진 노드는 라벨을 숨기고 호버·포커스 때만 보인다."
      },
      "edge": {
        "involves": {
          "$value": "#2D6359",
          "$description": "직접 관련: 2px 실선 + 화살표"
        },
        "structurally-related": {
          "$value": "#626B68",
          "$description": "구조적 관련: 2px 파선 [6,3] + 화살표"
        },
        "follows": {
          "$value": "#895F34",
          "$description": "후속 사건: 1.5px 실선 + 화살표"
        },
        "shares-issue": {
          "$value": "#858B88",
          "$description": "사건 공유(파생): 1.5px 점선 [2,3], 방향 없음"
        },
        "label": {
          "$value": "#474F4C",
          "$description": "간선 가운데 관계 요약 글자(선을 따라 회전, 배경 surface-base)"
        }
      }
    },
    "dark": {
      "brand": {
        "$type": "color",
        "primary": {
          "$value": "#47A189",
          "$description": "다크 브랜드 딥 세이지 틸(네온 금지)"
        },
        "primary-hover": {
          "$value": "#58B198",
          "$description": "다크 호버(OKLCH L+0.05)"
        },
        "primary-active": {
          "$value": "#36927A",
          "$description": "다크 눌림(OKLCH L-0.05)"
        },
        "primary-foreground": {
          "$value": "#0A1612",
          "$description": "다크 브랜드 위 어두운 글자(5.9:1)"
        }
      },
      "neutral": {
        "$type": "color",
        "surface-base": {
          "$value": "#0E1110"
        },
        "surface-raised": {
          "$value": "#161918"
        },
        "surface-overlay": {
          "$value": "#1D2220"
        },
        "surface-sunken": {
          "$value": "#090C0B"
        },
        "surface-selected": {
          "$value": "#1A2A25"
        },
        "border-subtle": {
          "$value": "#2B2F2D"
        },
        "border-strong": {
          "$value": "#3E4442"
        },
        "border-control": {
          "$value": "#6B726F"
        },
        "border-focus": {
          "$value": "#47A189"
        },
        "text-primary": {
          "$value": "#ECEFEE"
        },
        "text-secondary": {
          "$value": "#BABFBD"
        },
        "text-tertiary": {
          "$value": "#979D9A"
        },
        "text-inverse": {
          "$value": "#0E1110"
        }
      },
      "semantic": {
        "$type": "color",
        "up": {
          "$value": "#EB827B"
        },
        "down": {
          "$value": "#79A6E9"
        },
        "warning": {
          "$value": "#D9AF75"
        },
        "error": {
          "$value": "#EA808A"
        }
      },
      "graph": {
        "$type": "color",
        "node-issue": {
          "$value": "#7C8985"
        },
        "node-glyph": {
          "$value": "#0E1110"
        },
        "node-mark": {
          "$value": "#ECEFEE"
        },
        "focus-ring": {
          "$value": "#47A189"
        },
        "dimmed-opacity": {
          "$type": "number",
          "$value": 0.22
        },
        "edge": {
          "involves": {
            "$value": "#83AFA6"
          },
          "structurally-related": {
            "$value": "#8D9491"
          },
          "follows": {
            "$value": "#C8A47A"
          },
          "shares-issue": {
            "$value": "#6D7371"
          },
          "label": {
            "$value": "#BABFBD"
          }
        }
      }
    }
  },
  "typography": {
    "web": {
      "$description": "서비스 web/(src/index.css @theme) 기준 값(2026-10-30, #451). 아래 fontFamily·fontSize는 prototype/web 빌드(build-tokens.mjs)가 읽는 프로토타입 값으로 남겨 둔다.",
      "fontFamily": {
        "$type": "fontFamily",
        "body": {
          "$value": ["Pretendard Variable", "Pretendard", "sans-serif"],
          "$description": "본문·패널(--font-panel). pretendard 패키지의 dynamic-subset woff2, OFL-1.1."
        },
        "heading": {
          "$value": ["Wanted Sans Variable", "Pretendard Variable", "sans-serif"],
          "$description": "h1~h4와 ZOOP 로고 글자(--font-heading). wanted-sans 패키지의 split woff2, OFL-1.1."
        },
        "num": {
          "$value": ["SUIT Variable", "Pretendard Variable", "sans-serif"],
          "$description": "숫자·시세·시각(--font-num, font-num). @sun-typeface/suit 패키지의 variable woff2, OFL-1.1, font-display: swap."
        }
      },
      "fontSize": {
        "$type": "dimension",
        "caption": {
          "$value": "12px",
          "$description": "출처, 시각, 배지. 웹에서 가장 작은 글자 크기다. 줄 간격 1.5."
        },
        "body": {
          "$value": "14px",
          "$description": "본문, 패널. 줄 간격 1.6."
        },
        "lead": {
          "$value": "16px",
          "$description": "강조할 본문. 줄 간격 1.6."
        },
        "title-sm": {
          "$value": "18px",
          "$description": "카드·섹션 제목. 줄 간격 1.45."
        },
        "title": {
          "$value": "22px",
          "$description": "화면 소제목. 줄 간격 1.35."
        },
        "display": {
          "$value": "28px",
          "$description": "화면 제목. 줄 간격 1.25."
        }
      }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "SUIT Variable",
          "SUIT",
          "-apple-system",
          "BlinkMacSystemFont",
          "Apple SD Gothic Neo",
          "Malgun Gothic",
          "system-ui",
          "sans-serif"
        ],
        "$description": "프로토타입 값. SUIT Variable(@sun-typeface/suit@2.0.5, OFL-1.1, wght 100~900) 자체 호스팅. KS X 1001 2,668자 밖의 음절은 시스템 한글 서체로 폴백. 서비스 web/은 typography.web.fontFamily를 따른다."
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "monospace"
        ],
        "$description": "디자인시스템의 토큰명·경로 표기 전용 시스템 모노 스택(웹폰트 로드 없음)"
      }
    },
    "fontSize": {
      "$type": "dimension",
      "sm": {
        "$value": "13px",
        "$description": "보조 설명, 발행 시각, 출처, 각주, 법적 고지 하한선 (13px 미만 사용 엄격 금지)"
      },
      "base": {
        "$value": "15px",
        "$description": "기본 본문 텍스트 (본문 최소 15px 규칙 충족)"
      },
      "md": {
        "$value": "16px",
        "$description": "모바일 폼 입력 필드(iOS 자동 확대 방지 기준), 강조 본문, 버튼 라벨"
      },
      "lg": {
        "$value": "18px",
        "$description": "섹션 헤더, 리스트 제목, 카드 소제목"
      },
      "xl": {
        "$value": "22px",
        "$description": "패널 헤딩, 다이얼로그 타이틀, 종목명 대표 수치"
      },
      "2xl": {
        "$value": "28px",
        "$description": "화면 메인 제목, 온보딩 대형 헤딩 (화면당 1회 제한)"
      }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "일반 본문"
      },
      "medium": {
        "$value": 500,
        "$description": "강조 본문, 폼 라벨, 탭 제목"
      },
      "semibold": {
        "$value": 600,
        "$description": "섹션 제목, 리스트 헤더, 종목명"
      },
      "bold": {
        "$value": 700,
        "$description": "화면 메인 제목, 대표 가격/수치"
      }
    },
    "lineHeight": {
      "$type": "number",
      "none": {
        "$value": 1.0,
        "$description": "아이콘 및 배지 단일 라인"
      },
      "tight": {
        "$value": 1.25,
        "$description": "대형 헤딩, 대표 수치"
      },
      "snug": {
        "$value": 1.375,
        "$description": "리스트 제목, 버튼 라벨"
      },
      "normal": {
        "$value": 1.5,
        "$description": "기본 본문 텍스트"
      },
      "relaxed": {
        "$value": 1.625,
        "$description": "원문 인용구, 긴 서술형 설명"
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em",
        "$description": "헤딩 및 한글 본문 가독성 보정"
      },
      "normal": {
        "$value": "0em",
        "$description": "기본 자간"
      },
      "wide": {
        "$value": "0.02em",
        "$description": "수치 및 대문자 라벨"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": {
      "$value": "0px"
    },
    "1": {
      "$value": "4px",
      "$description": "초소형 여백, 칩 내부 인라인 간격"
    },
    "2": {
      "$value": "8px",
      "$description": "소형 여백, 컴포넌트 내부 요소 간 간격"
    },
    "3": {
      "$value": "12px",
      "$description": "중소형 여백, 버튼 좌우 패딩, 리스트 행 내부 요소 간격"
    },
    "4": {
      "$value": "16px",
      "$description": "기본 여백 (글로벌 거터), 화면 좌우 여백, 패널 내부 패딩"
    },
    "5": {
      "$value": "20px",
      "$description": "네비게이션에서 제목까지의 간격"
    },
    "6": {
      "$value": "24px",
      "$description": "중대형 여백, 섹션 간 간격, 모달 내부 패딩"
    },
    "8": {
      "$value": "32px",
      "$description": "대형 여백, 페이지 상하 마진"
    },
    "10": {
      "$value": "40px",
      "$description": "페이지 블록 간격"
    },
    "12": {
      "$value": "48px",
      "$description": "모바일 하단 터치 안전 여백"
    },
    "16": {
      "$value": "64px",
      "$description": "온보딩 대형 섹션 간격"
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px",
      "$description": "목록 행, 섹션, 패널 항목 등 내부 콘텐츠 (카드 박스화 금지, 행+구분선으로 평탄화)"
    },
    "sm": {
      "$value": "8px",
      "$description": "인터랙티브 컨트롤: 버튼, 텍스트 입력창, 세그먼트 탭 선택 배경"
    },
    "lg": {
      "$value": "16px",
      "$description": "떠 있는 표면: 바텀시트 상단 모서리, 다이얼로그 모달, 토스트, 팝오버"
    },
    "full": {
      "$value": "9999px",
      "$description": "원형 인터랙티브 컨트롤: 라디오 버튼, 스위치 토글 썸, 원형 노드"
    }
  },
  "elevation": {
