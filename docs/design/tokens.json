        "color": "transparent",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "그림자 없음. 테두리가 있는 컨테이너는 항상 이것."
    },
    "raised": {
      "$value": {
        "color": "rgba(12, 18, 16, 0.08)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$description": "세그먼트 선택 항목처럼 테두리 없는 작은 들린 요소"
    },
    "overlay": {
      "$value": {
        "color": "rgba(12, 18, 16, 0.12)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "16px",
        "spread": "-2px"
      },
      "$description": "팝오버·툴팁·토스트(테두리 없이)"
