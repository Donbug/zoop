    "modal": {
      "$value": {
        "color": "rgba(12, 18, 16, 0.20)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "-4px"
      },
      "$description": "다이얼로그·시트(테두리 없이)"
    }
